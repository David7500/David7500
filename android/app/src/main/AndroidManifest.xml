<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Lastna lega: prek `https://kajros.app` v WebView JE varen kontekst in
         `navigator.geolocation` dela. Prek `http://192.168…` v brskalniku ne
         (izmerjeno: window.isSecureContext = false) — to je edina omejitev
         iz CLAUDE.md, ki jo aplikacija odpravi. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Dovoljenje za lego sicer pomeni PRIVZETO `required="true"` za strojno
         opremo (izmerjeno z `aapt2 dump badging`: uses-implied-feature …
         reason='requested ACCESS_*_LOCATION'), in trgovina bi aplikacijo
         skrila vsaki napravi brez GPS. Brez lege dela vse razen gumba
         „kje sem“, zato je zahteva izrecno neobvezna. -->
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.location.network" android:required="false" />

    <!-- Budilka. `USE_EXACT_ALARM` (33+) dobi aplikacija, ki JE budilka, brez
         vprašanja; `SCHEDULE_EXACT_ALARM` je pot za starejše. Brez enega od
         njiju `setAlarmClock` ne obstaja in budilka ni budilka. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Zaslon se mora prižgati sam, tudi ko je telefon zaklenjen. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Zvoni storitev v ospredju, ne zaslon: zaslon se brez dovoljenja za cel
         zaslon ne odpre, in 14. 9. 2026 budilka zato ni zbudila. Vrsta
         `systemExempted` pripada aplikacijam z `USE_EXACT_ALARM`. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SYSTEM_EXEMPTED" />
    <!-- Ob ponovnem zagonu telefona so vse načrtovane budnice izgubljene. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/ime"
        android:networkSecurityConfig="@xml/omrezje"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="false"
        android:theme="@style/Tema">

        <activity
            android:name=".GlavnaDejavnost"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density|fontScale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Bliznjica ob dolgem pritisku na ikono: naslov streznika. -->
            <intent-filter>
                <action android:name="app.kajros.NASTAVITVE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/bliznjice" />
        </activity>

        <activity
            android:name=".BudilkeDejavnost"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Tema">
            <intent-filter>
                <action android:name="app.kajros.BUDILKE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Zvonjenje čez ves zaslon. `singleInstance`, da se dve budilki ne
             zložita ena na drugo, in brez zgodovine, da po ustavitvi ne ostane
             v seznamu nedavnih. -->
        <activity
            android:name=".ZvonjenjeDejavnost"
            android:exported="false"
            android:launchMode="singleInstance"
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:showOnLockScreen="true"
            android:turnScreenOn="true"
            android:taskAffinity=".zvonjenje"
            android:theme="@style/Tema" />

        <service
            android:name=".ZvonjenjeStoritev"
            android:exported="false"
            android:foregroundServiceType="systemExempted" />

        <!-- Widget na domacem zaslonu. `exported=false` zadosca: sistem
             posilja `APPWIDGET_UPDATE` naravnost tej komponenti, ne po imenu
             akcije, zato ga ni treba odpirati vsem. -->
        <receiver
            android:name=".Widget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

        <receiver
            android:name=".Sprozilec"
            android:exported="true"
            android:directBootAware="true">
            <!-- `PROZI` pride od nas samih prek `PendingIntent` in ga zunaj ni
                 mogoče poslati; `BOOT_COMPLETED` pa mora biti viden sistemu. -->
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
