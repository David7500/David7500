<?xml version="1.0" encoding="utf-8"?>
<!-- Samo za izbirnik widgetov (`previewLayout`). Privzeti 4×2 iz
     `w_tabla_srednji` z izmišljeno tablo, ne podatkom; tretja vrstica je brez
     zamude, ker je ravno to najpogostejši primer in se iz treh izmerjenih
     vrstic ne bi videlo. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_ozadje"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/krog_vlak"
            android:importantForAccessibility="no"
            android:padding="6dp"
            android:src="@drawable/ikona_vlak"
            android:tint="@color/m_na_kont" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_tabla_predogled_postaja"
            android:textColor="@color/ink"
            android:textSize="15.5sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/gumb_krog"
            android:importantForAccessibility="no"
            android:padding="9dp"
            android:src="@drawable/ikona_osvezi"
            android:tint="@color/gumb_ikona" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:text="06:53"
            android:textColor="@color/ink"
            android:textSize="16.5sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="LPV 2010 → Koper"
            android:textColor="@color/ink_dim"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="tir 3"
            android:textColor="@color/ink_mute"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:gravity="end"
            android:minWidth="40dp"
            android:text="+4"
            android:textColor="@color/d_small"
            android:textSize="13.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:text="07:12"
            android:textColor="@color/ink"
            android:textSize="16.5sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="IC 502 → Maribor"
            android:textColor="@color/ink_dim"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="tir 1"
            android:textColor="@color/ink_mute"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:gravity="end"
            android:minWidth="40dp"
            android:text="točno"
            android:textColor="@color/d_ontime"
            android:textSize="13.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:text="07:25"
            android:textColor="@color/ink"
            android:textSize="16.5sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="LP 2433 → Kranj"
            android:textColor="@color/ink_dim"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text=""
            android:textColor="@color/ink_mute"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:gravity="end"
            android:minWidth="40dp"
            android:text="—"
            android:textColor="@color/ink_faint"
            android:textSize="13.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="@string/widget_tabla_predogled_ob"
        android:textColor="@color/ink_faint"
        android:textSize="11sp" />
</LinearLayout>
