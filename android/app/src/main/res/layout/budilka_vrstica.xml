<?xml version="1.0" encoding="utf-8"?>
<!-- Ena budilka. Vrstni red je vrstni red vprašanj: kaj pelje, kdaj zvoni,
     kdaj gre vozilo, kako in po čem — in nazadnje, kdaj smo to nazadnje
     vedeli. Ura zvonjenja je največja, ker je edina, zaradi katere je budilka. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginTop="10dp"
    android:padding="14dp"
    android:background="@drawable/vrstica">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/kaj"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/ink"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/smer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:textColor="@color/ink_mute"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <Switch
            android:id="@+id/vklop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:contentDescription="@string/budilka_vklop" />
    </LinearLayout>

    <TextView
        android:id="@+id/zvoni"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:textColor="@color/accent"
        android:textSize="19sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/odhod"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:textColor="@color/ink_dim"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/kako"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:textColor="@color/ink_faint"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/vir"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/ink_faint"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp"
        android:gravity="end">

        <Button
            android:id="@+id/odpri_voznjo"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="14dp"
            android:textAllCaps="false"
            android:textColor="@color/ink_dim"
            android:textSize="14sp"
            android:text="@string/budilka_odpri_voznjo" />

        <Button
            android:id="@+id/odstrani"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:paddingStart="14dp"
            android:paddingEnd="4dp"
            android:textAllCaps="false"
            android:textColor="@color/sev_bad"
            android:textSize="14sp"
            android:text="@string/budilka_odstrani" />
    </LinearLayout>
</LinearLayout>
