<?xml version="1.0" encoding="utf-8"?>
<!-- Tabla 4×2: glava z gumboma (osveži, pri avtobusu obrni stran ceste), tri
     vrstice in ura podatka. Brez ure je „+4“ izpred pol ure videti enako kot
     „+4“ izpred pol minute; dotik ure osveži. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_ozadje"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:id="@+id/glava"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ikona"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/krog_vlak"
            android:importantForAccessibility="no"
            android:padding="6dp"
            android:src="@drawable/ikona_vlak" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/postaja"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/ink"
                android:textSize="15.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/smer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/ink_dim"
                android:textSize="11.5sp"
                android:visibility="gone" />
        </LinearLayout>

        <ImageView
            android:id="@+id/ovira"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/gumb_krog"
            android:importantForAccessibility="yes"
            android:padding="9dp"
            android:src="@drawable/ikona_ovira"
            android:tint="@color/ovira_na_kont"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/obrni"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/gumb_krog"
            android:contentDescription="@string/widget_tabla_obrni"
            android:padding="9dp"
            android:src="@drawable/ikona_obrni"
            android:tint="@color/gumb_ikona"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/osvezi"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/gumb_krog"
            android:contentDescription="@string/widget_tabla_osvezi"
            android:padding="9dp"
            android:src="@drawable/ikona_osvezi"
            android:tint="@color/gumb_ikona" />
    </LinearLayout>

    <TextView
        android:id="@+id/sporocilo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="3"
        android:textColor="@color/ink_dim"
        android:textSize="13sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/v1"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/ura1"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:maxLines="1"
            android:textColor="@color/ink"
            android:textSize="16.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/kam1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/ink_dim"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tir1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:maxLines="1"
            android:textColor="@color/ink_mute"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/zam1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:gravity="end"
            android:maxLines="1"
            android:minWidth="40dp"
            android:textSize="13.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/v2"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/ura2"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:maxLines="1"
            android:textColor="@color/ink"
            android:textSize="16.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/kam2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/ink_dim"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tir2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:maxLines="1"
            android:textColor="@color/ink_mute"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/zam2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:gravity="end"
            android:maxLines="1"
            android:minWidth="40dp"
            android:textSize="13.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/v3"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/ura3"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:maxLines="1"
            android:textColor="@color/ink"
            android:textSize="16.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/kam3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/ink_dim"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tir3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:maxLines="1"
            android:textColor="@color/ink_mute"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/zam3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:gravity="end"
            android:maxLines="1"
            android:minWidth="40dp"
            android:textSize="13.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/ob"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/ink_faint"
        android:textSize="11sp" />
</LinearLayout>
