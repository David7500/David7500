<?xml version="1.0" encoding="utf-8"?>
<!-- O aplikaciji: katera različica je na telefonu in posodobitev do konca.
     Do 1.11 je bila posodobitev samo vrstica na dnu strani, ki se je pokazala
     enkrat na dan; različice ni bilo videti nikjer. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <!-- Dolg pritisk odpre dnevnik, kot na seznamu budilk: v njem je
             vzrok posodobitve, ki ni uspela. -->
        <TextView
            android:id="@+id/glava"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="4dp"
            android:paddingTop="22dp"
            android:paddingBottom="14dp"
            android:text="@string/o_aplikaciji"
            android:textColor="@color/ink"
            android:textSize="24sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/kartica"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="20dp">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:importantForAccessibility="no"
                android:src="@mipmap/ic_launcher" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ime"
                    android:textColor="@color/ink"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/razlicica"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/ink"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/podrobno"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/ink_dim"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Tonska (rjava), kadar čaka nova različica; siva, kadar ne. -->
        <LinearLayout
            android:id="@+id/kartica_posodobitev"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/kartica"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="18dp"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/posodobitve"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/posodobitve"
                android:textColor="@color/ink"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/stanje"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingMultiplier="1.25"
                android:textColor="@color/ink"
                android:textSize="15sp" />

            <ProgressBar
                android:id="@+id/napredek"
                style="@android:style/Widget.Material.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:indeterminateTint="@color/poudarek"
                android:max="100"
                android:progressBackgroundTint="@color/m_na_kont_2"
                android:progressTint="@color/poudarek"
                android:visibility="gone" />

            <Button
                android:id="@+id/glavni"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/pilula_polna"
                android:stateListAnimator="@null"
                android:textAllCaps="false"
                android:textColor="@color/na_poudarku"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <Button
                android:id="@+id/preveri"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/pilula_obroba"
                android:stateListAnimator="@null"
                android:text="@string/gumb_preveri"
                android:textAllCaps="false"
                android:textColor="@color/ink"
                android:textSize="15sp"
                android:visibility="gone" />

            <!-- Stara pot čez brskalnik. Samo, ko pot v aplikaciji ne gre:
                 sistemski namestitveni program vzame budilki cel zaslon. -->
            <Button
                android:id="@+id/s_strani"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="6dp"
                android:background="@drawable/pilula_tiha"
                android:minHeight="40dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/gumb_s_strani"
                android:textAllCaps="false"
                android:textColor="@color/ink_dim"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/preverjeno"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/ink_mute"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
