<?xml version="1.0" encoding="utf-8"?>
<!-- Samo za izbirnik widgetov (`previewLayout`, Android 12+). Slika ikone je
     tam pokazala znamko, ne widgeta, in človek se odloča za tisto, kar vidi.
     `Chronometer` tu ne teče, zato je odštevanje navaden napis; vse ostalo je
     ista postavitev kot v `widget.xml`. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_ozadje_kont"
    android:padding="14dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="@string/widget_predogled_kaj"
        android:textColor="@color/m_na_kont"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="@string/widget_predogled_kje"
        android:textColor="@color/m_na_kont_2"
        android:textSize="12sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/widget_predogled_stevec"
        android:textColor="@color/m_na_kont"
        android:textSize="32sp"
        android:textStyle="bold"
        android:fontFeatureSettings="tnum" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:text="@string/widget_predogled_pod"
        android:textColor="@color/m_na_kont_2"
        android:textSize="12sp" />
</LinearLayout>
