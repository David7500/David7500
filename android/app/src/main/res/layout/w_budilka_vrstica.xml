<?xml version="1.0" encoding="utf-8"?>
<!-- Vrstica seznama budilk: ura zvonjenja, vožnja in postaja, dnevi, stikalo.
     Stikalo pošlje `PREKLOPI` z id-jem budilke (`setOnClickFillInIntent`). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="50dp"
    android:paddingTop="4dp">

    <LinearLayout
        android:id="@+id/bud_vrstica"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="2dp">

        <TextView
            android:id="@+id/bud_ura"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:textColor="@color/m_na_kont"
            android:textSize="19sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/bud_kaj"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/m_na_kont_2"
                android:textSize="12.5sp" />

            <TextView
                android:id="@+id/bud_dni"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/m_na_kont_2"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/bud_stikalo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="yes"
            android:padding="6dp" />
    </LinearLayout>
</FrameLayout>
