<?xml version="1.0" encoding="utf-8"?>
<!-- Budilke 2×2: dve, vsaka s stikalom. Ozka vrstica ima stikalo ob uri in
     vožnjo z dnevi pod njima: na 130 dp ura, vožnja in stikalo v eni vrsti
     ne gredo. Stikalo preklopi budilko na mestu, dotik drugje odpre seznam.
     Vklopljena vrstica je tonska (rjava ali zelena po omrežju), ugasnjena siva. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_ozadje"
    android:orientation="vertical"
    android:padding="10dp">

    <TextView
        android:id="@+id/bud_glava"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingStart="4dp"
        android:text="@string/widget_budilke_glava"
        android:textColor="@color/ink"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Brez budilk widget ne sme biti prazen pravokotnik: povedati mora, da
         ni okvara, in kje se budilka nastavi. -->
    <TextView
        android:id="@+id/bud_prazno"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="4"
        android:paddingStart="4dp"
        android:text="@string/widget_budilke_kako"
        android:textColor="@color/ink_dim"
        android:textSize="13sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/bud_vrstica1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/widget_vrstica_vklop"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="4dp"
        android:paddingEnd="4dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/bud_ura1"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:autoSizeMaxTextSize="18sp"
                android:autoSizeMinTextSize="12sp"
                android:autoSizeStepGranularity="0.5sp"
                android:autoSizeTextType="uniform"
                android:fontFeatureSettings="tnum"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:textColor="@color/m_na_kont"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/bud_stikalo1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="yes"
                android:padding="2dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/bud_kaj1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/m_na_kont_2"
            android:textSize="11.5sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bud_vrstica2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/widget_vrstica_vklop"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="4dp"
        android:paddingEnd="4dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/bud_ura2"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:autoSizeMaxTextSize="18sp"
                android:autoSizeMinTextSize="12sp"
                android:autoSizeStepGranularity="0.5sp"
                android:autoSizeTextType="uniform"
                android:fontFeatureSettings="tnum"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:textColor="@color/m_na_kont"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/bud_stikalo2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="yes"
                android:padding="2dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/bud_kaj2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/m_na_kont_2"
            android:textSize="11.5sp" />
    </LinearLayout>

    <!-- Kadar jih je več, kot jih gre na widget. -->
    <TextView
        android:id="@+id/bud_vec"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="1"
        android:paddingStart="4dp"
        android:textColor="@color/ink_mute"
        android:textSize="11sp"
        android:visibility="gone" />
</LinearLayout>
