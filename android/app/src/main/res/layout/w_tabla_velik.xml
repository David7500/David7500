<?xml version="1.0" encoding="utf-8"?>
<!-- Tabla 4×3 in več (od Androida 12): glava, ovira, seznam, ki se drsi, in
     ura podatka. Seznam nosi vse odhode v štirih urah; vrstico napolni
     `w_tabla_vrstica`. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_ozadje"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:id="@+id/glava"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ikona"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/krog_vlak"
            android:importantForAccessibility="no"
            android:padding="6dp"
            android:src="@drawable/ikona_vlak" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Ozek seznam (2×3) ima za ime postaje komaj 70 dp: pomanjša se
                 samo, preden ga odreže tropičje. -->
            <TextView
                android:id="@+id/postaja"
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:autoSizeMaxTextSize="15.5sp"
                android:autoSizeMinTextSize="11sp"
                android:autoSizeStepGranularity="0.5sp"
                android:autoSizeTextType="uniform"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:textColor="@color/ink"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/smer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/ink_dim"
                android:textSize="11.5sp"
                android:visibility="gone" />
        </LinearLayout>

        <ImageView
            android:id="@+id/ovira"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/gumb_krog"
            android:importantForAccessibility="yes"
            android:padding="9dp"
            android:src="@drawable/ikona_ovira"
            android:tint="@color/ovira_na_kont"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/obrni"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/gumb_krog"
            android:contentDescription="@string/widget_tabla_obrni"
            android:padding="9dp"
            android:src="@drawable/ikona_obrni"
            android:tint="@color/gumb_ikona"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/osvezi"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/gumb_krog"
            android:contentDescription="@string/widget_tabla_osvezi"
            android:padding="9dp"
            android:src="@drawable/ikona_osvezi"
            android:tint="@color/gumb_ikona" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/opozorilo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="2dp"
        android:background="@drawable/opozorilo_vrstica"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ikona_ovira"
            android:tint="@color/ovira_na_kont" />

        <TextView
            android:id="@+id/opozorilo_besedilo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/ovira_na_kont"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/sporocilo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="3"
        android:textColor="@color/ink_dim"
        android:textSize="13sp"
        android:visibility="gone" />

    <ListView
        android:id="@+id/seznam"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:scrollbarStyle="outsideOverlay" />

    <TextView
        android:id="@+id/ob"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/ink_faint"
        android:textSize="11sp" />
</LinearLayout>
