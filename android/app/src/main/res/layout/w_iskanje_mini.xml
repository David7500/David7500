<?xml version="1.0" encoding="utf-8"?>
<!-- Iskalna vrstica v eni celici: samo povečevalo, ki odpre „Kam greš?“. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/kam"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:background="@drawable/pilula_tonska"
        android:contentDescription="@string/widget_iskanje_kam"
        android:scaleType="center"
        android:src="@drawable/ikona_isci"
        android:tint="@color/ink_dim" />
</FrameLayout>
