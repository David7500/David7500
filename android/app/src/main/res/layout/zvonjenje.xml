<?xml version="1.0" encoding="utf-8"?>
<!-- Zaslon, ki ga vidiš zaspan. Zato dvoje in nič drugega: kaj pelje in kdaj,
     ter dva velika gumba. Vse ostalo bi bilo v tem trenutku šum. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:fitsSystemWindows="true"
    android:background="@color/bg"
    android:padding="28dp">

    <TextView
        android:id="@+id/zvoni_naslov"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/ink"
        android:textSize="28sp"
        android:textStyle="bold"
        android:lineSpacingMultiplier="1.2" />

    <TextView
        android:id="@+id/zvoni_zakaj"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:textColor="@color/ink_dim"
        android:textSize="17sp"
        android:lineSpacingMultiplier="1.3" />

    <Button
        android:id="@+id/ustavi"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:background="@drawable/gumb"
        android:paddingTop="20dp"
        android:paddingBottom="20dp"
        android:textAllCaps="false"
        android:textColor="@color/na_poudarku"
        android:textSize="19sp"
        android:textStyle="bold"
        android:text="@string/ustavi" />

    <Button
        android:id="@+id/se_malo"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/gumb_tih"
        android:paddingTop="18dp"
        android:paddingBottom="18dp"
        android:textAllCaps="false"
        android:textColor="@color/ink_dim"
        android:textSize="17sp"
        android:text="@string/se_malo" />
</LinearLayout>
