<?xml version="1.0" encoding="utf-8"?>
<!-- Zaslon zvonjenja „Peron“ (prototip v design/budilka/): zgoraj kaj pelje
     in kdaj, na sredi prizor, v katerem vozilo potegneš do sebe, spodaj
     odlog. Gumba „Ustavi“ ni: ustavi poteg, bralnik zaslona dvojni dotik na
     prizoru, in gumb v obvestilu, ki ostane ves čas zvonjenja. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="10dp"
            android:paddingEnd="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/ura_zdaj"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:textColor="@color/ink_dim"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/faza"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="5dp">

                    <View
                        android:id="@+id/faza_pika"
                        android:layout_width="7dp"
                        android:layout_height="7dp" />

                    <TextView
                        android:id="@+id/faza_besedilo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/zvoni_naslov"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="6dp"
                android:lineSpacingMultiplier="1.1"
                android:textColor="@color/ink"
                android:textSize="26sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="true"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/zvoni_odpelje"
                    android:textColor="@color/ink_dim"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/zvoni_odhod"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:fontFamily="monospace"
                    android:textColor="@color/ink"
                    android:textSize="34sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/zvoni_zamuda"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:fontFamily="monospace"
                    android:paddingStart="9dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="9dp"
                    android:paddingBottom="5dp"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/zvoni_zakaj"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingMultiplier="1.3"
                android:textColor="@color/ink_mute"
                android:textSize="14sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <app.kajros.PeronPogled
                android:id="@+id/prizor"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/prizor_opis"
                android:focusable="true" />

            <FrameLayout
                android:id="@+id/napredek_tir"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_gravity="bottom"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginBottom="48dp"
                android:background="@drawable/napredek_tir"
                android:importantForAccessibility="no">

                <View
                    android:id="@+id/napredek"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/napredek"
                    android:scaleX="0"
                    android:transformPivotX="0dp" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/namig_vrstica"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:importantForAccessibility="noHideDescendants"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/namig"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:shadowColor="#000000"
                    android:shadowRadius="10"
                    android:textColor="@color/ink"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/namig_puscica"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/namig_puscica"
                    android:textColor="@color/poudarek"
                    android:textSize="15sp" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="12dp"
            android:paddingEnd="24dp"
            android:paddingBottom="22dp">

            <!-- Samo, kadar prizora ni mogoče narisati: takrat ni česa vleči. -->
            <Button
                android:id="@+id/ustavi_zasilno"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/gumb"
                android:paddingTop="20dp"
                android:paddingBottom="20dp"
                android:text="@string/ustavi"
                android:textAllCaps="false"
                android:textColor="@color/na_poudarku"
                android:textSize="19sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <Button
                android:id="@+id/se_malo"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/gumb_odlog"
                android:paddingStart="26dp"
                android:paddingEnd="26dp"
                android:text="@string/se_malo"
                android:textAllCaps="false"
                android:textColor="@color/ink_dim"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Prototip ima pod tem zameglitev; prizora za SurfaceView ni mogoče
         zamegliti, zato je podlaga temnejša, da se besedilo bere. -->
    <LinearLayout
        android:id="@+id/konec"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#e6060912"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/kljukica"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:text="@string/kljukica"
            android:textColor="@color/poudarek"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/konec_naslov"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:accessibilityLiveRegion="assertive"
            android:gravity="center"
            android:textColor="@color/ink"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/konec_besedilo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.4"
            android:maxWidth="300dp"
            android:textColor="@color/ink_dim"
            android:textSize="16sp" />
    </LinearLayout>
</FrameLayout>
