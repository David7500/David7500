<?xml version="1.0" encoding="utf-8"?>
<!-- Widget, ki nima česa pokazati, pove zakaj: ni postaje, ni budilke, še ni
     odgovora. Prazen pravokotnik je videti kot okvara, tudi kadar to ni. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_ozadje"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/naslov"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/ink"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/besedilo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="4"
        android:textColor="@color/ink_dim"
        android:textSize="12sp" />
</LinearLayout>
