<?xml version="1.0" encoding="utf-8"?>
<!-- Iste vrednosti kot `kajros/static/base.css`. Prepisane so, ker Android
     CSS ne bere; ce se tam spremenijo, se morajo tudi tu — sicer se nativni
     zaslon in stran razideta ravno v trenutku, ko stran ni dosegljiva. -->
<resources>
    <color name="bg">#0f1115</color>
    <color name="bg_raised">#16181c</color>
    <color name="ink">#e7eaf0</color>
    <color name="ink_dim">#9aa3b0</color>
    <color name="ink_mute">#79828f</color>
    <color name="ink_faint">#6b7480</color>
    <color name="sev_bad">#d1495b</color>
    <color name="sev_hard">#d9b33c</color>
    <!-- Lestvica zamud, iste vrednosti kot žetoni `d` v base.css. Razred pove
         strežnik (`stats.opis_zamude()`), barva je oblikovanje in je tu. -->
    <color name="d_ontime">#7c8698</color>
    <color name="d_small">#f2a87e</color>
    <color name="d_mid">#e07b45</color>
    <color name="d_big">#b85417</color>
    <color name="accent">#e07b45</color>
    <color name="line_firm">#2b303a</color>
    <!-- Besedilo NA poudarku, ne poudarek sam: belo na oranzni ne bi
         doseglo kontrasta. Ista vrednost kot `.btn` v base.css. -->
    <color name="na_poudarku">#14161a</color>
    <!-- Zaslon zvonjenja: noč pred zoro na peronu (design/budilka/). Svoja
         paleta, ker je prizor nebo, ne stran; poudarek je toplejši od
         `accent`, da ga je v temi videti. -->
    <color name="noc">#060912</color>
    <color name="poudarek">#f0934f</color>
    <color name="nezno">#8fb4ff</color>
    <!-- Materialove vloge iz base.css (vloge `m-*` in `deli-*`) za seznam budilk:
         vklopljena budilka je tonska kartica kot na domači strani, ugasnjena
         siva, deljenje indigo kot oblika „Deli lego“. -->
    <color name="m_kont">#5a2e12</color>
    <color name="m_na_kont">#ffdbc8</color>
    <color name="m_na_kont_2">#e6b8a0</color>
    <color name="m_visoka">#1e2229</color>
    <color name="m_obroba">#79828f</color>
    <color name="deli_kont">#232b55</color>
    <color name="deli_na_kont">#e3e6ff</color>
    <color name="deli_na_kont_2">#c7cdf0</color>
    <color name="deli_tiho">#aab3e6</color>
    <color name="deli_gumb">#b9c3ff</color>
    <color name="deli_na_gumb">#1a1d3a</color>
    <!-- Materialova barva napake na temni podlagi. `sev_bad` na rjavi kartici
         ne doseže kontrasta (2,3 : 1), ta 7 : 1. -->
    <color name="napaka">#ffb4ab</color>
    <color name="napaka_kont">#3a1b1e</color>
</resources>
