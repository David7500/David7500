<?xml version="1.0" encoding="utf-8"?>
<!-- Ročica: ugasnjena 16 dp, vklopljena 24 dp. Prozorna škatla 22 x 32 da
     stikalu širino (2 x 22 + odmika = 52) in višino. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <layer-list>
            <item android:width="22dp" android:height="32dp">
                <shape android:shape="rectangle"><solid android:color="@android:color/transparent" /></shape>
            </item>
            <item android:width="24dp" android:height="24dp" android:gravity="center">
                <shape android:shape="oval"><solid android:color="#ffffff" /></shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:width="22dp" android:height="32dp">
                <shape android:shape="rectangle"><solid android:color="@android:color/transparent" /></shape>
            </item>
            <item android:width="16dp" android:height="16dp" android:gravity="center">
                <shape android:shape="oval"><solid android:color="#ffffff" /></shape>
            </item>
        </layer-list>
    </item>
</selector>
