<?xml version="1.0" encoding="utf-8"?>
<!-- Vklopljeno stikalo avtobusne budilke: zeleno kot njena vrstica. Oblika
     ista kot `stikalo_slika_vklop` (slika, ker `Switch` v RemoteViews šele 12+). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="44dp" android:height="26dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/bus_na_kont" />
            <corners android:radius="13dp" />
        </shape>
    </item>
    <item android:width="20dp" android:height="20dp"
        android:gravity="center_vertical|end" android:end="3dp">
        <shape android:shape="oval">
            <solid android:color="@color/bus_kont" />
        </shape>
    </item>
</layer-list>
