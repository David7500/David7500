<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="44dp" android:height="26dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="2dp" android:color="@color/m_obroba" />
            <corners android:radius="13dp" />
        </shape>
    </item>
    <item android:width="13dp" android:height="13dp"
        android:gravity="center_vertical|start" android:start="7dp">
        <shape android:shape="oval">
            <solid android:color="@color/m_obroba" />
        </shape>
    </item>
</layer-list>
