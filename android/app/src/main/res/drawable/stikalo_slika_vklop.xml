<?xml version="1.0" encoding="utf-8"?>
<!-- Stikalo Material 3 kot slika, za widget. `Switch` v RemoteViews zna
     šele API 31 (`setCompoundButtonChecked`), aplikacija gre od 26; slika
     je ista na vseh. Oblika in barve kot `stikalo_*.xml` v seznamu. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="44dp" android:height="26dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/m_na_kont" />
            <corners android:radius="13dp" />
        </shape>
    </item>
    <item android:width="20dp" android:height="20dp"
        android:gravity="center_vertical|end" android:end="3dp">
        <shape android:shape="oval">
            <solid android:color="@color/m_kont" />
        </shape>
    </item>
</layer-list>
