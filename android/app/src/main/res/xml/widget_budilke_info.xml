<?xml version="1.0" encoding="utf-8"?>
<!--
  Ta widget **nima `updatePeriodMillis`** in ga ne rabi: ničesar ne pridobiva
  iz omrežja in ura zvonjenja se med dvema spremembama budilk ne premakne.
  Prerišejo ga `Widgeti.osvezi()` ob vsaki spremembi in `Sprozilec`, ko se
  budilka tako ali tako zbudi. Interval bi bil prebujanje telefona za sliko,
  ki je ista.

  Privzeto 2×2 (dve budilki s stikali), pomanjšati se da do ene ikone z
  enim stikalom, raztegniti do seznama vseh (Android 12+). Kaj pokaže katera
  velikost, odloči `Velikost`.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:minResizeWidth="40dp"
    android:minResizeHeight="40dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/w_budilke_kvadrat"
    android:previewLayout="@layout/widget_budilke_predogled"
    android:previewImage="@drawable/ikona_znak"
    android:resizeMode="horizontal|vertical"
    android:description="@string/widget_budilke_opis"
    android:widgetCategory="home_screen" />
