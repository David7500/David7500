[Unit]
Description=sztrack — samo zajem (brez strežnika)
Documentation=https://github.com/David7500/David7500
Wants=network-online.target
After=network-online.target
# Feed občasno resetira povezavo; naj ponovni zagon nikoli ne obvelja za "prepogost".
StartLimitIntervalSec=0

[Service]
Type=simple
User=sztrack
Group=sztrack
WorkingDirectory=/opt/sztrack
Environment=SZ_DATA_DIR=/var/lib/sztrack
Environment=SZ_POLL_SECONDS=30
# Vozni red se osvežuje sam, v podprocesu -- da se vrh pomnilnika po uvozu
# vrne sistemu. Brez tega bi nove vožnje sčasoma odpadle iz zajema.
Environment=SZ_REFRESH=subprocess
Environment=SZ_REFRESH_HOUR=4
# Avtobusi. Prazno = samo vlaki (in nadomestni prevozi SŽ).
# `1118` doda LPP, `1118,1123,1119,1121` vse prevoznike.
Environment=SZ_AGENCIES=
# Zajema se SAMO tisto, česar kasneje ni mogoče dobiti: zamude in obvestila.
# Vreme ima arhiv za nazaj, statistika je izpeljanka `run` -- oboje se izračuna
# na računalniku, ko je baza tam. Lega vozil je samo "zdaj" in se ne hrani.
ExecStart=/opt/sztrack/.venv/bin/python -m sztrack.cli collect
Restart=always
RestartSec=15

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sztrack

[Install]
WantedBy=multi-user.target
