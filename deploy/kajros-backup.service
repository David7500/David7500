[Unit]
Description=kajros — varnostna kopija baze

[Service]
Type=oneshot
User=kajros
Group=kajros
Environment=DATA=/var/lib/kajros
Environment=KEEP=3
# Koliko prostora mora ostati, da se kopija sploh splaca. Pod tem raje ne
# naredimo nicesar in to povemo -- polna kartica ustavi tudi ZAJEM, kopija pa
# je le kratkorocna varovalka. Dolgorocni arhiv je racunalnik, ki bazo potegne.
Environment=MIN_FREE_MB=2000
# Vse delo je v skripti (`deploy/varnostna-kopija-baze.sh`): VACUUM INTO
# namesto `.backup`, ki se je ob živem zajemu vrtel do 58 min. Skripto
# posodobi `git push`; ta enota se spremeni samo, kadar se spremeni klic.
ExecStart=/bin/sh /opt/kajros/deploy/varnostna-kopija-baze.sh
