[Unit]
Description=sztrack — zajem zamud SŽ in API
Documentation=https://github.com/David7500/David7500
Wants=network-online.target
After=network-online.target
# Feed občasno resetira povezavo; naj ponovni zagon nikoli ne obvelja za "prepogost".
StartLimitIntervalSec=0

[Service]
Type=simple
User=sztrack
Group=sztrack
WorkingDirectory=/opt/sztrack
Environment=SZ_DATA_DIR=/var/lib/sztrack
Environment=PORT=8000
Environment=SZ_POLL_SECONDS=30
# Na Pi je dovolj pomnilnika, da vozni red osvežuje sam.
# Uvoz teče v podprocesu, da se pomnilnik po njem vrne sistemu.
Environment=SZ_REFRESH=subprocess
Environment=SZ_REFRESH_HOUR=4
# Avtobusi. Prazno = samo vlaki (in nadomestni prevozi SŽ).
# `1118` doda LPP: baza 1,9 -> 6,3 MB, vrh pomnilnika ob uvozu 59 -> 86 MB.
# Pi Zero W ima 427 MB in to prenese; VSEH agencij (vrh 216 MB) ne.
# Uvoz teče v podprocesu, zato se ta vrh po njem vrne sistemu.
Environment=SZ_AGENCIES=
ExecStart=/opt/sztrack/.venv/bin/python -m uvicorn sztrack.api:app --host 0.0.0.0 --port ${PORT} --no-access-log
Restart=always
RestartSec=15

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sztrack

[Install]
WantedBy=multi-user.target
