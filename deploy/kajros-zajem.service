[Unit]
Description=kajros — samo zajem (brez strežnika)
Documentation=https://github.com/David7500/David7500
Wants=network-online.target
After=network-online.target
# Feed občasno resetira povezavo; naj ponovni zagon nikoli ne obvelja za "prepogost".
StartLimitIntervalSec=0

[Service]
Type=simple
User=kajros
Group=kajros
WorkingDirectory=/opt/kajros
Environment=KAJROS_DATA_DIR=/var/lib/kajros
Environment=KAJROS_POLL_SECONDS=30
# Vozni red se osvežuje sam, v podprocesu -- da se vrh pomnilnika po uvozu
# vrne sistemu. Brez tega bi nove vožnje sčasoma odpadle iz zajema.
Environment=KAJROS_REFRESH=subprocess
Environment=KAJROS_REFRESH_HOUR=4
# Vsi prevozniki. Malina je edina naprava, ki teče ves čas, zato mora zajeti
# VSE -- meritev, ki je ta trenutek nihče ne posname, ne obstaja nikoli več.
#
# Pomnilnik to prenese, izmerjeno na tej malini (Pi Zero W): 427 MB RAM in
# 426 MB swapa, od tega v rabi 122 + 11. Zajem sam je pri sami železnici
# 38 MB RSS; vrh ob uvozu voznega reda je pri vseh štirih agencijah ~216 MB,
# in ker teče v podprocesu (`KAJROS_REFRESH=subprocess`), se po njem vrne sistemu.
#
# Disk: dnevnik `obs` se obrezuje (železnica 90 dni, avtobusi 14) in se ustali
# pri ~356 MB; `run` raste ~3,4 GB na leto. Na kartici je 20 GB prostega.
Environment=KAJROS_AGENCIES=1118,1119,1121,1123
# Mestni LPP je tu IZKLOPLJEN, čeprav je privzeto vklopljen.
#
# Ne zato, ker ne bi sodil v zajem -- sodi, in malina je edina naprava, ki teče
# ves čas. Ampak ker cena na Pi Zero W **ni izmerjena**: uvoz doda 42 MB GTFS
# in ~16 000 voženj z ~410 000 postanki, živi feed pa je 315 kB vsakih 30 s in
# brez ETaga, torej vsakič cel prenos. Stroj, ki je pri SQLite ~100× počasnejši
# od razvojnega računalnika, se lahko ob tem zaduši -- in če se zaduši zajem,
# izgubimo tudi tisto, kar zdaj dela.
#
# Zato: najprej izmeri (čas uvoza, vrh RSS, ali obhod ostane pod 30 s), potem
# prižgi. Do takrat mestni LPP zajema samo stroj s strežnikom.
Environment=KAJROS_LPP=0
# Senčno merjenje napovedi je tu IZKLOPLJENO, čeprav je privzeto vklopljeno.
#
# `ocena.tick()` teče v isti zanki kot zajem, ne v svoji niti. Izmerjeno:
# en obhod je na razvojnem računalniku 141 ms, Pi Zero W je pri istem poslu
# ~100× počasnejši (SQLite v pomnilniku: 88,7 s proti 0,90 s), torej **~14 s**
# vsakih 120. Naslednji zajem bi se za toliko zamaknil -- natanko drift, ki je
# v docs/MERITVE.md že zapisan kot napaka (razmiki 19, 11, 19, 11 s namesto 10).
#
# Malina ima eno nalogo in ta je zajem. Senca se meri tam, kjer teče strežnik.
# Ko bo malina 4B ali 5, je obhod ~1,4 s in to ponovno premisli.
Environment=KAJROS_OCENA=0
# Zajema se SAMO tisto, česar kasneje ni mogoče dobiti: zamude in obvestila.
# Vreme ima arhiv za nazaj, statistika je izpeljanka `run` -- oboje se izračuna
# na računalniku, ko je baza tam. Lega vozil je samo "zdaj" in se ne hrani.
ExecStart=/opt/kajros/.venv/bin/python -m kajros.cli collect
Restart=always
RestartSec=15

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/kajros

[Install]
WantedBy=multi-user.target
